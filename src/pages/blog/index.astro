---
import Base from "@/layouts/base.astro";
import { EN } from "@i18n/en";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
---

<Base title="Blog" description="Main Blog site">
  <main class="grow content-start">
    <h1 class="text-3xl mb-6 text-center text-primary">✍🏻 Blog</h1>
    <div class="grid md:grid-cols-2 gap-5 p-4 m-auto justify-center text-primary-content">
      {
        posts.map((post) => (
          <div class="card card-sm  m-auto shadow-sm bg-secondary hover:bg-primary border-accent border-2">
            <figure class="w-full md:h-96 overflow-hidden">
              <img src={post.data.image} alt="Post cover" loading="lazy" />
            </figure>
            <div class="card-body ">
              <h2 class="card-title text-xl font-bold">{post.data.title}</h2>
              <p class="text-xs text-justify">{post.data.pubDate.toLocaleDateString()}</p>
              <p class="text-base text-justify">{post.data.description}</p>
              <div class="card-actions justify-around">
                <a class="btn btn-info" href={`${post.collection}/${post.id}`}>
                  {EN.blog.read}
                </a>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </main>
</Base>
