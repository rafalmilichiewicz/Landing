---
import Base from "@/layouts/base.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}
type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.description}>
  <main class="grow content-start">
    <article class="mx-auto max-w-3xl px-5 py-10 sm:py-16">
      <a
        href="/blog"
        class="link link-hover mb-10 inline-flex items-center gap-2 text-sm opacity-70"
      >
        <span aria-hidden="true">&larr;</span>
        Back to Blog
      </a>

      <header class="mb-8 space-y-5">
        <p class="text-sm opacity-60">
          {post.data.pubDate.toLocaleDateString()}
        </p>

        <h1 class="text-4xl font-semibold leading-tight tracking-tight sm:text-5xl">
          {post.data.title}
        </h1>

        <p class="text-lg leading-relaxed opacity-70">
          {post.data.description}
        </p>
      </header>

      <div class="mb-10 overflow-hidden rounded-2xl">
        <img
          src={post.data.image}
          alt={post.data.title}
          class="aspect-video w-full object-cover"
          fetchpriority="high"
        />
      </div>

      <div
        class="prose prose-lg max-w-none
           prose-headings:font-semibold
           prose-a:link
           prose-img:rounded-xl"
      >
        <Content />
      </div>

      <footer class="mt-16 border-t border-base-300 pt-6">
        <a href="/blog" class="btn btn-ghost btn-sm gap-2">
          <span aria-hidden="true">&larr;</span>
          Back to all articles
        </a>
      </footer>
    </article>
  </main>
</Base>
